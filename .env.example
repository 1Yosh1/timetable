# Timetable Management System — environment template
# Copy this file to `.env` in the project root and adjust the values.
# `.env` is read by app/bootstrap.php (EnvLoader) and by db_config.php.
#
# XAMPP defaults (the values below are correct for a stock XAMPP install)
APP_DEBUG=0
DB_HOST=localhost
DB_NAME=timetable
DB_USER=root
DB_PASS=
DB_PORT=3306

# MAMP defaults — uncomment these two lines if you use MAMP instead
#DB_PASS=root
#DB_PORT=8889
